{
    "version": 3,
    "configurePresets": [
        {
            "name": "host-test",
            "displayName": "Host Off-Target Unit Tests (Clang + Ninja)",
            "description": "Builds and executes host unit tests using MinGW Clang and Ninja with CTest",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-host",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Host Release Build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-test",
            "configurePreset": "host-test"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ],
    "testPresets": [
        {
            "name": "host-test",
            "configurePreset": "host-test",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
